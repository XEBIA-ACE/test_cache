# ================================================================
# Cache Service - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to source control.
# ================================================================

# ----------------------------------------------------------------
# Spring Boot
# ----------------------------------------------------------------
SPRING_PROFILES_ACTIVE=standalone   # standalone | sentinel | cluster
SERVER_PORT=8080

# ----------------------------------------------------------------
# Redis - Standalone Mode
# ----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_TIMEOUT=2000

# ----------------------------------------------------------------
# Redis - Sentinel Mode (set SPRING_PROFILES_ACTIVE=sentinel)
# ----------------------------------------------------------------
REDIS_SENTINEL_MASTER=mymaster
# Comma-separated list of sentinel nodes: host:port,host:port
REDIS_SENTINEL_NODES=localhost:26379,localhost:26380,localhost:26381
REDIS_SENTINEL_PASSWORD=

# ----------------------------------------------------------------
# Redis - Cluster Mode (set SPRING_PROFILES_ACTIVE=cluster)
# ----------------------------------------------------------------
# Comma-separated list of cluster nodes: host:port,host:port
REDIS_CLUSTER_NODES=localhost:7000,localhost:7001,localhost:7002,localhost:7003,localhost:7004,localhost:7005
REDIS_CLUSTER_MAX_REDIRECTS=3

# ----------------------------------------------------------------
# Redis Connection Pool (Lettuce)
# ----------------------------------------------------------------
REDIS_POOL_MAX_ACTIVE=16
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=2
REDIS_POOL_MAX_WAIT=1000

# ----------------------------------------------------------------
# Cache Settings
# ----------------------------------------------------------------
# Default TTL in seconds (0 = no expiry)
CACHE_DEFAULT_TTL=3600
# Maximum key length allowed
CACHE_MAX_KEY_LENGTH=512
# Maximum value size in bytes (1MB default)
CACHE_MAX_VALUE_SIZE=1048576
# Key namespace prefix
CACHE_NAMESPACE=cache-service

# ----------------------------------------------------------------
# Distributed Lock Settings (Redisson)
# ----------------------------------------------------------------
LOCK_DEFAULT_WAIT_TIME=5000
LOCK_DEFAULT_LEASE_TIME=30000

# ----------------------------------------------------------------
# Observability
# ----------------------------------------------------------------
MANAGEMENT_PORT=8081
LOG_LEVEL=INFO
LOG_FORMAT=json   # json | text
