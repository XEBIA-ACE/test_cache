##############################################################################
# Cache Service – Environment Variable Reference
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
##############################################################################

# ── Application ───────────────────────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ── Redis Mode ────────────────────────────────────────────────────────────────
# Allowed values: standalone | sentinel | cluster
REDIS_MODE=standalone

# ── Standalone Redis ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
REDIS_COMMAND_TIMEOUT_MS=5000

# ── Redis Sentinel (only when REDIS_MODE=sentinel) ────────────────────────────
REDIS_SENTINEL_MASTER=mymaster
# Comma-separated list: host1:port1,host2:port2
REDIS_SENTINEL_NODES=localhost:26379,localhost:26380,localhost:26381
REDIS_SENTINEL_PASSWORD=

# ── Redis Cluster (only when REDIS_MODE=cluster) ──────────────────────────────
# Comma-separated list: host1:port1,host2:port2,...
REDIS_CLUSTER_NODES=localhost:7000,localhost:7001,localhost:7002,localhost:7003,localhost:7004,localhost:7005
REDIS_CLUSTER_MAX_REDIRECTS=3
REDIS_CLUSTER_PASSWORD=

# ── Lettuce Connection Pool ───────────────────────────────────────────────────
REDIS_POOL_MAX_ACTIVE=16
REDIS_POOL_MAX_IDLE=8
REDIS_POOL_MIN_IDLE=2
# -1 = wait indefinitely for a connection from the pool
REDIS_POOL_MAX_WAIT_MS=-1

# ── Redisson Pool ─────────────────────────────────────────────────────────────
REDISSON_POOL_MIN_IDLE=2
REDISSON_POOL_SIZE=10
REDISSON_IDLE_TIMEOUT_MS=10000
REDISSON_CONNECT_TIMEOUT_MS=10000
REDISSON_TIMEOUT_MS=3000
REDISSON_RETRY_ATTEMPTS=3
REDISSON_RETRY_INTERVAL_MS=1500
